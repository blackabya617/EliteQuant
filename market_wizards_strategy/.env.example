# --- Alpaca paper trading (free, no funding required) ---
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Orders are printed and NOT sent unless this is exactly "true".
EXECUTE_PAPER_TRADES=false

# --- Telegram (optional) ---
# bot token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (optional) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
